@model IEnumerable<MultiVendorMarketplace.Domain.Entities.Product>
@inject MultiVendorMarketplace.Application.Interfaces.IApplicationDbContext DbContext
@{
    ViewData["Title"] = "Marketplace Home";
    var categories = ViewBag.Categories as IEnumerable<MultiVendorMarketplace.Domain.Entities.Category> ?? new List<MultiVendorMarketplace.Domain.Entities.Category>();
    var selectedCategory = ViewBag.SelectedCategory as int?;
    var searchTerm = ViewBag.SearchTerm as string;
    
    var allCount = DbContext.Products.Count(p => p.IsApproved && p.Vendor!.IsApproved && p.StockQuantity > 0);
}

<div class="relative rounded-3xl overflow-hidden mb-12 bg-gradient-to-br from-indigo-950 via-slate-950 to-slate-900 p-8 sm:p-12 border border-slate-800/80 shadow-2xl bg-grid-mesh">
    <div class="relative z-10 max-w-2xl">
        <span class="px-3 py-1 text-[10px] font-bold tracking-widest text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 rounded-full uppercase">Multi-Vendor Marketplace</span>
        <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
            Find unique products from
            <span class="bg-gradient-to-r from-indigo-400 via-violet-400 to-pink-400 bg-clip-text text-transparent">creative makers</span>
        </h1>
        <p class="mt-3 text-xs sm:text-sm text-slate-400 leading-relaxed">
            Discover artisanal crafts, retro apparel, and custom home items sold directly by independent designers. Every transaction supports small vendors globally.
        </p>

        <!-- Search Bar -->
        <form asp-controller="Home" asp-action="Index" method="get" class="mt-6 flex flex-col sm:flex-row gap-3">
            <input type="hidden" name="categoryId" value="@selectedCategory" />
            <div class="relative flex-grow">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                    <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                <input type="text" name="search" value="@searchTerm" placeholder="Search handcrafted mugs, leather jackets..." class="block w-full pl-10 pr-3 py-2.5 text-sm border border-slate-800/80 rounded-xl bg-slate-950/80 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" />
            </div>
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs px-5 py-2.5 rounded-xl font-bold transition shadow-lg shadow-indigo-600/15 hover:shadow-indigo-600/25">Search Catalog</button>
        </form>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Sidebar Filters -->
    <div class="lg:col-span-1 space-y-6">
        <div class="p-6 rounded-2xl bg-slate-950/30 border border-slate-800/80 shadow-xl">
            <h2 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-slate-900 pb-2">Categories</h2>
            <div class="space-y-1">
                <a asp-controller="Home" asp-action="Index" asp-route-search="@searchTerm" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-all duration-200 @(selectedCategory == null ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/10" : "text-slate-400 hover:bg-slate-900/60 hover:text-white")">
                    <span>All Categories</span>
                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold @(selectedCategory == null ? "bg-indigo-700 text-white" : "bg-slate-900 text-slate-500")">@allCount</span>
                </a>
                @foreach (var cat in categories)
                {
                    var count = DbContext.Products.Count(p => p.CategoryId == cat.Id && p.IsApproved && p.Vendor!.IsApproved && p.StockQuantity > 0);
                    <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-search="@searchTerm" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-all duration-200 @(selectedCategory == cat.Id ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/10" : "text-slate-400 hover:bg-slate-900/60 hover:text-white")">
                        <span>@cat.Name</span>
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold @(selectedCategory == cat.Id ? "bg-indigo-700 text-white" : "bg-slate-900 text-slate-500")">@count</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Product Grid -->
    <div class="lg:col-span-3">
        @if (!Model.Any())
        {
            <div class="text-center py-20 p-8 rounded-2xl bg-slate-950/20 border border-dashed border-slate-800/80 flex flex-col items-center">
                <!-- Shopping Bag with Magnifying Glass SVG -->
                <svg class="h-16 w-16 text-slate-700 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-75 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM21 21l-3.5-3.5" />
                    <circle cx="14" cy="14" r="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3 class="text-base font-bold text-white">No products found</h3>
                <p class="mt-1.5 text-xs text-slate-500 max-w-xs leading-relaxed">We couldn't find any products matching your selection. Try adjusting your search query or choosing another category.</p>
                <a asp-controller="Home" asp-action="Index" class="mt-5 inline-block bg-indigo-600/20 text-indigo-400 border border-indigo-500/20 px-4 py-2 rounded-xl text-xs font-bold hover:bg-indigo-600/30 transition">Clear Filters</a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                @foreach (var product in Model)
                {
                    <div class="group relative rounded-2xl bg-slate-950/30 border border-slate-800/80 overflow-hidden flex flex-col justify-between hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-1 shadow-lg">
                        <div class="relative">
                            <!-- Product Image -->
                            <div class="h-56 w-full overflow-hidden bg-slate-900">
                                <img src="@product.ImageUrl" alt="@product.Name" class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-500" />
                            </div>
                            
                            <!-- Stock Indicator Badge -->
                            <div class="absolute top-3 right-3 z-10">
                                @if (product.StockQuantity <= 0)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[9px] font-bold bg-rose-500/10 border border-rose-500/20 text-rose-400">✗ Sold Out</span>
                                }
                                else if (product.StockQuantity <= 3)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[9px] font-bold bg-amber-500/10 border border-amber-500/20 text-amber-400">⚠ Low Stock (@product.StockQuantity left)</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[9px] font-bold bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">✔ In Stock</span>
                                }
                            </div>
                        </div>
                        
                        <!-- Product Body -->
                        <div class="p-5 flex-grow flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between text-[10px] mb-2">
                                    <span class="text-indigo-400 font-bold bg-indigo-500/5 px-2.5 py-0.5 rounded-lg border border-indigo-500/10">@product.Category?.Name</span>
                                    <span class="text-slate-500 italic">by @(product.Vendor?.StoreName ?? "Seller")</span>
                                </div>
                                <h3 class="text-sm font-bold text-white group-hover:text-indigo-400 transition-colors duration-300 line-clamp-1">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                        @product.Name
                                    </a>
                                </h3>
                                <p class="mt-1 text-xs text-slate-400 line-clamp-2 leading-relaxed">@product.Description</p>
                            </div>
                            
                            <div>
                                <div class="mt-4 pt-4 border-t border-slate-900 flex items-center justify-between">
                                    <span class="text-base font-extrabold text-white">@product.Price.ToString("C")</span>
                                </div>

                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2 rounded-xl text-[11px] transition duration-300 flex items-center justify-center space-x-1.5 shadow-lg shadow-indigo-600/10 hover:shadow-indigo-600/20">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
                                        </svg>
                                        <span>Add to Cart</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
