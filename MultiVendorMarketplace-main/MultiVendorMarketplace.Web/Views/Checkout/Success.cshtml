@model MultiVendorMarketplace.Domain.Entities.Order
@{
    ViewData["Title"] = "Payment Successful";
}

<div class="max-w-3xl mx-auto space-y-8">
    <!-- Step Progress Bar -->
    <div class="mb-8 max-w-lg mx-auto">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 uppercase tracking-widest">
            <span class="text-emerald-500 flex items-center"><span class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center mr-1.5 text-[9px]">1</span> Cart</span>
            <span class="w-12 h-px bg-emerald-600"></span>
            <span class="text-emerald-500 flex items-center"><span class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center mr-1.5 text-[9px]">2</span> Checkout</span>
            <span class="w-12 h-px bg-emerald-600"></span>
            <span class="text-emerald-500 flex items-center"><span class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center mr-1.5 text-[9px]">3</span> Payment</span>
            <span class="w-12 h-px bg-emerald-600"></span>
            <span class="text-emerald-400 flex items-center"><span class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center mr-1.5 text-[9px]">✔</span> Success</span>
        </div>
    </div>

    <!-- Success Banner -->
    <div class="text-center p-8 rounded-3xl bg-emerald-500/10 border border-emerald-500/20 shadow-xl space-y-4">
        <div class="relative mx-auto flex items-center justify-center h-24 w-24 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            <!-- Ping Ring -->
            <div class="absolute inset-0 rounded-full bg-emerald-500/10 animate-ping"></div>
            <svg class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
            </svg>
        </div>
        <h1 class="text-3xl font-black text-white tracking-tight">Payment Completed!</h1>
        <p class="text-xs text-emerald-400/90 font-semibold max-w-md mx-auto leading-relaxed">Order #@Model.Id has been successfully processed in the Stripe Connect Sandbox.</p>
        
        <div class="flex items-center justify-center space-x-2 text-xs text-emerald-400/80 bg-emerald-500/5 border border-emerald-500/10 p-3 rounded-2xl max-w-sm mx-auto mt-4">
            <svg class="w-4 h-4 shrink-0 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
            </svg>
            <span>We'll send you a confirmation email shortly.</span>
        </div>
    </div>

    <!-- Order Details -->
    <div class="p-6 rounded-3xl bg-slate-900/40 border border-slate-800/80 space-y-6 shadow-xl">
        <div class="flex flex-col sm:flex-row justify-between border-b border-slate-850 pb-4 gap-4">
            <div>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Order Date</p>
                <p class="text-xs font-bold text-white mt-1">@Model.OrderDate.ToString("MMMM dd, yyyy - hh:mm tt")</p>
            </div>
            <div>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Shipping To</p>
                <p class="text-xs font-bold text-white mt-1">@Model.ShippingAddress</p>
            </div>
            <div>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Payment Status</p>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mt-1">
                    Paid
                </span>
            </div>
        </div>

        <h3 class="text-sm font-bold text-white mb-2 uppercase tracking-wider text-slate-400">Purchased Items</h3>
        <div class="divide-y divide-slate-850">
            @foreach (var item in Model.OrderItems)
            {
                <div class="py-4 flex items-center justify-between gap-4">
                    <div class="flex items-center space-x-4">
                        <img src="@item.Product?.ImageUrl" alt="@item.Product?.Name" class="w-12 h-12 rounded-xl object-cover border border-slate-800 shrink-0" />
                        <div>
                            <p class="text-xs font-bold text-white">@item.Product?.Name</p>
                            <p class="text-[10px] text-slate-500 mt-0.5">Qty: @item.Quantity • Price: @item.UnitPrice.ToString("C")</p>
                            <p class="text-[10px] text-indigo-400 font-bold italic mt-0.5">Sold by: @(item.Vendor?.StoreName ?? "Seller")</p>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-slate-300">@( (item.UnitPrice * item.Quantity).ToString("C") )</span>
                </div>
            }
        </div>

        <div class="border-t border-slate-850 pt-4 flex justify-between items-baseline">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider">Total Charged</span>
            <span class="text-2xl font-black text-indigo-400">@Model.TotalAmount.ToString("C")</span>
        </div>
    </div>

    <!-- Next Actions -->
    <div class="flex flex-col items-center space-y-4 pt-4">
        <a asp-controller="Home" asp-action="Index" class="bg-gradient-to-r from-indigo-500 to-violet-500 hover:from-indigo-600 hover:to-violet-600 text-white font-bold py-3.5 px-8 rounded-xl transition duration-300 shadow-lg shadow-indigo-600/10 hover:shadow-indigo-600/20 text-xs uppercase tracking-wider">
            Continue Shopping
        </a>
        <p class="text-[10px] text-slate-600 italic text-center">* An order placement notification has been written to the /emails/ directory.</p>
    </div>
</div>
