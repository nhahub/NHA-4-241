@using Microsoft.AspNetCore.Identity
@using MultiVendorMarketplace.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Multi-Vendor Marketplace</title>
    <!-- Tailwind compiled stylesheet -->
    <link rel="stylesheet" href="~/dist/tailwind.css" asp-append-version="true" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 flex flex-col min-h-full">
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
    <header class="sticky top-0 z-50 glassmorphism-dark border-b border-slate-800/80">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-2 text-xl font-bold bg-gradient-to-r from-indigo-400 to-violet-400 bg-clip-text text-transparent hover:from-indigo-300 hover:to-violet-300 transition-all duration-300">
                        <svg class="w-8 h-8 text-indigo-400 inline" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.5a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"></path>
                        </svg>
                        <span>MarketHub</span>
                    </a>
                </div>

                <!-- Desktop Links -->
                <div class="hidden md:flex items-center space-x-5">
                    <a asp-controller="Home" asp-action="Index" class="px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 @(currentController == "Home" && currentAction == "Index" ? "text-indigo-400 bg-indigo-500/10 border border-indigo-500/20" : "text-slate-300 hover:text-white hover:bg-slate-800/30")">Marketplace</a>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        if (currentUser != null)
                        {
                            if (currentUser.UserType == "Admin")
                            {
                                <a asp-controller="Admin" asp-action="Index" class="px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 @(currentController == "Admin" && currentAction == "Index" ? "text-indigo-400 bg-indigo-500/10 border border-indigo-500/20" : "bg-indigo-600/10 text-indigo-300 border border-indigo-500/20 hover:bg-indigo-600/20")">Admin Panel</a>
                                <a asp-controller="Admin" asp-action="PendingProducts" class="px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 @(currentController == "Admin" && currentAction == "PendingProducts" ? "text-indigo-400 bg-indigo-500/10 border border-indigo-500/20" : "text-slate-300 hover:text-white hover:bg-slate-800/30")">Pending Items</a>
                                <a asp-controller="Admin" asp-action="SystemStatus" class="px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 @(currentController == "Admin" && currentAction == "SystemStatus" ? "text-indigo-400 bg-indigo-500/10 border border-indigo-500/20" : "text-slate-300 hover:text-white hover:bg-slate-800/30")">System Stats</a>
                            }
                            else if (currentUser.UserType == "Vendor")
                            {
                                <a asp-controller="Vendor" asp-action="Dashboard" class="px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 @(currentController == "Vendor" && currentAction == "Dashboard" ? "text-violet-400 bg-violet-500/10 border border-violet-500/20" : "bg-violet-600/10 text-violet-300 border border-violet-500/20 hover:bg-violet-600/20")">Vendor Dashboard</a>
                                <a asp-controller="Vendor" asp-action="Products" class="px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 @(currentController == "Vendor" && (currentAction == "Products" || currentAction == "CreateProduct" || currentAction == "EditProduct") ? "text-violet-400 bg-violet-500/10 border border-violet-500/20" : "text-slate-300 hover:text-white hover:bg-slate-800/30")">My Products</a>
                            }
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-slate-400 hover:text-red-400 px-3 py-2 rounded-xl text-sm font-semibold transition hover:bg-red-500/5">Log Out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 @(currentController == "Account" && currentAction == "Login" ? "text-indigo-400 bg-indigo-500/10 border border-indigo-500/20" : "text-slate-300 hover:text-white hover:bg-slate-800/30")">Sign In</a>
                        <a asp-controller="Account" asp-action="Register" class="bg-gradient-to-r from-indigo-500 to-violet-500 hover:from-indigo-600 hover:to-violet-600 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow-lg hover:shadow-indigo-500/20 transition duration-300">Sign Up</a>
                    }

                    <!-- Shopping Cart Icon -->
                    <a asp-controller="Cart" asp-action="Index" class="relative p-2 text-slate-300 hover:text-white transition hover-cart-bounce @(currentController == "Cart" && currentAction == "Index" ? "text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 rounded-xl" : "")">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
                        </svg>
                    </a>
                </div>

                <!-- Mobile Navigation Toggle -->
                <div class="flex items-center space-x-2 md:hidden">
                    <a asp-controller="Cart" asp-action="Index" class="relative p-2 text-slate-300 hover:text-white transition rounded-xl hover:bg-slate-800/40">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
                        </svg>
                    </a>
                    <button id="mobile-menu-btn" type="button" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/50 focus:outline-none transition-all">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Mobile Menu Drawer -->
            <div id="mobile-menu" class="hidden md:hidden border-t border-slate-850 pb-4 pt-2 space-y-1">
                <a asp-controller="Home" asp-action="Index" class="block px-3 py-2 rounded-xl text-base font-semibold transition @(currentController == "Home" && currentAction == "Index" ? "bg-indigo-600/20 text-indigo-400 font-bold" : "text-slate-300 hover:bg-slate-800/40 hover:text-white")">Marketplace</a>

                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    if (currentUser != null)
                    {
                        if (currentUser.UserType == "Admin")
                        {
                            <a asp-controller="Admin" asp-action="Index" class="block px-3 py-2 rounded-xl text-base font-semibold transition @(currentController == "Admin" && currentAction == "Index" ? "bg-indigo-600/20 text-indigo-400 font-bold" : "text-slate-300 hover:bg-slate-800/40 hover:text-white")">Admin Panel</a>
                            <a asp-controller="Admin" asp-action="PendingProducts" class="block px-3 py-2 rounded-xl text-base font-semibold transition @(currentController == "Admin" && currentAction == "PendingProducts" ? "bg-indigo-600/20 text-indigo-400 font-bold" : "text-slate-300 hover:bg-slate-800/40 hover:text-white")">Pending Items</a>
                            <a asp-controller="Admin" asp-action="SystemStatus" class="block px-3 py-2 rounded-xl text-base font-semibold transition @(currentController == "Admin" && currentAction == "SystemStatus" ? "bg-indigo-600/20 text-indigo-400 font-bold" : "text-slate-300 hover:bg-slate-800/40 hover:text-white")">System Stats</a>
                        }
                        else if (currentUser.UserType == "Vendor")
                        {
                            <a asp-controller="Vendor" asp-action="Dashboard" class="block px-3 py-2 rounded-xl text-base font-semibold transition @(currentController == "Vendor" && currentAction == "Dashboard" ? "bg-violet-600/20 text-violet-400 font-bold" : "text-slate-300 hover:bg-slate-800/40 hover:text-white")">Vendor Dashboard</a>
                            <a asp-controller="Vendor" asp-action="Products" class="block px-3 py-2 rounded-xl text-base font-semibold transition @(currentController == "Vendor" && currentAction == "Products" ? "bg-violet-600/20 text-violet-400 font-bold" : "text-slate-300 hover:bg-slate-800/40 hover:text-white")">My Products</a>
                        }
                    }

                    <form asp-controller="Account" asp-action="Logout" method="post" class="block w-full">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full text-left px-3 py-2 rounded-xl text-base font-semibold text-slate-400 hover:bg-red-500/10 hover:text-red-400 transition">Log Out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="block px-3 py-2 rounded-xl text-base font-semibold transition @(currentController == "Account" && currentAction == "Login" ? "bg-indigo-600/20 text-indigo-400 font-bold" : "text-slate-300 hover:bg-slate-800/40 hover:text-white")">Sign In</a>
                    <div class="px-3 pt-2">
                        <a asp-controller="Account" asp-action="Register" class="block text-center bg-gradient-to-r from-indigo-500 to-violet-500 hover:from-indigo-600 hover:to-violet-600 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-lg transition">Sign Up</a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center space-x-2 animate-slide-down-fade">
                <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="font-medium text-sm">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center space-x-2 animate-slide-down-fade">
                <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 001.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
                <span class="font-medium text-sm">@TempData["Error"]</span>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="mt-auto border-t border-slate-900 bg-slate-950/80 py-12 text-slate-400 text-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <!-- Brand Section -->
                <div class="space-y-4 col-span-1 md:col-span-2">
                    <div class="flex items-center space-x-2">
                        <svg class="w-6 h-6 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.5a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"></path>
                        </svg>
                        <span class="text-base font-extrabold text-white">MarketHub</span>
                    </div>
                    <p class="text-slate-500 max-w-sm leading-relaxed text-[11px]">
                        Discover unique handcrafted crafts, apparel, and custom home items direct from creators globally. Every purchase empowers independent sellers.
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="space-y-3">
                    <p class="text-white font-bold uppercase tracking-wider text-[10px]">Marketplace</p>
                    <ul class="space-y-2">
                        <li><a asp-controller="Home" asp-action="Index" class="hover:text-white transition">Explore Products</a></li>
                        <li><a asp-controller="Account" asp-action="Register" class="hover:text-white transition">Join as Seller</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-white transition">Privacy Policy</a></li>
                    </ul>
                </div>

                <!-- Social Links -->
                <div class="space-y-3">
                    <p class="text-white font-bold uppercase tracking-wider text-[10px]">Social Channels</p>
                    <div class="flex space-x-3 text-slate-500">
                        <a href="#" class="hover:text-indigo-400 transition" title="Twitter/X">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <a href="#" class="hover:text-indigo-400 transition" title="Instagram">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zM17.5 6.5h.01"/></svg>
                        </a>
                        <a href="#" class="hover:text-indigo-400 transition" title="GitHub">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="mt-8 pt-8 border-t border-slate-900 flex flex-col sm:flex-row justify-between items-center text-[11px] text-slate-600">
                <div>
                    &copy; 2026 MarketHub, Inc. All rights reserved.
                </div>
                <div class="flex space-x-4 mt-4 sm:mt-0">
                    <a href="#" class="hover:text-slate-400">Terms of Service</a>
                    <span>•</span>
                    <a href="#" class="hover:text-slate-400">Privacy Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Toggle mobile hamburger menu drawer
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        if (mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', () => {
                const isHidden = mobileMenu.classList.toggle('hidden');
                if (!isHidden) {
                    menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12'); // X icon
                } else {
                    menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16'); // Hamburger icon
                }
            });
        }

        // Global Form loading button state
        document.addEventListener('submit', (e) => {
            const form = e.target;
            if (form && form.tagName === 'FORM') {
                const submitBtns = form.querySelectorAll('button[type="submit"]');
                submitBtns.forEach(btn => {
                    if (!btn.classList.contains('no-spin')) {
                        // Prevent multiple submissions
                        btn.disabled = true;
                        
                        // Add spinner
                        const spinner = document.createElement('span');
                        spinner.className = 'btn-spinner';
                        btn.prepend(spinner);
                        btn.classList.add('opacity-75', 'cursor-not-allowed');
                    }
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
